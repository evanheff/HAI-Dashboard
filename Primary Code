```{r}
# ---- 2. Long -> one row per hospital x infection ---------------------------
hai <- hai_raw |>
  mutate(
    measure_num = str_match(`Measure ID`, "^HAI_(\\d)_")[, 2],
    measure_stat = str_remove(`Measure ID`, "^HAI_\\d_"),
    value = suppressWarnings(as.numeric(Score))   # "Not Available" -> NA
  )

# SIR-row metadata (CMS comparison category + footnote live on every row,
# but take them from the SIR row to avoid confusion)
sir_meta <- hai |>
  filter(measure_stat == "SIR") |>
  transmute(`Facility ID`, measure_num,
            compared_to_national = `Compared to National`,
            footnote = Footnote)

wide <- hai |>
  select(`Facility ID`, measure_num, measure_stat, value) |>
  pivot_wider(names_from = measure_stat, values_from = value,
              values_fn = first) |>
  rename(sir = SIR, observed = NUMERATOR, predicted = ELIGCASES,
         ci_lower = CILOWER, ci_upper = CIUPPER, exposure = DOPC)

fac <- hai |>
  distinct(`Facility ID`, `Facility Name`, `City/Town`, State, `ZIP Code`,
           `County/Parish`) |>
  rename(facility_id = `Facility ID`, facility_name = `Facility Name`,
         city = `City/Town`, state = State, zip = `ZIP Code`,
         county = `County/Parish`)

gen <- gen_raw |>
  transmute(facility_id = `Facility ID`,
            hospital_type = `Hospital Type`,
            ownership = `Hospital Ownership`,
            overall_rating = `Hospital overall rating`)

hospital_level <- wide |>
  rename(facility_id = `Facility ID`) |>
  left_join(sir_meta |> rename(facility_id = `Facility ID`),
            by = c("facility_id", "measure_num")) |>
  left_join(fac, by = "facility_id") |>
  left_join(gen, by = "facility_id") |>
  mutate(
    infection = unname(infection_labels[measure_num]),
    has_sir = !is.na(sir),
    is_state_or_dc = !state %in% c("AS", "GU", "MP", "PR", "VI"),
    county_key = paste0(str_to_title(county), ", ", state)
  ) |>
  # keep only hospital-infection pairs with usable counts
  filter(!is.na(observed), !is.na(predicted)) |>
  select(facility_id, facility_name, city, state, county, county_key, zip,
         hospital_type, ownership, overall_rating, infection, sir, ci_lower,
         ci_upper, observed, predicted, exposure, has_sir,
         compared_to_national, footnote, is_state_or_dc)
