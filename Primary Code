```{r}
# ---- 3. Pooled SIR with exact Poisson CI --------------------------
pool <- function(df, ...) {
  df |>
    group_by(..., infection) |>
    summarise(n_hospitals = n(),
              observed  = sum(observed),
              predicted = sum(predicted),
              .groups = "drop") |>
    filter(predicted > 0) |>
    mutate(
      sir = observed / predicted,
      ci_lower = if_else(observed == 0, 0,
                         qchisq(ALPHA / 2, 2 * observed) / 2 / predicted),
      ci_upper = qchisq(1 - ALPHA / 2, 2 * (observed + 1)) / 2 / predicted,
      reliable = predicted >= MIN_PRED,
      sir_mapped = if_else(reliable, sir, NA_real_),
      category = case_when(
        ci_upper < 1 ~ "Better than expected",
        ci_lower > 1 ~ "Worse than expected",
        TRUE ~ "No clear difference"
      )
    )
}

state_pooled  <- hospital_level |> filter(is_state_or_dc) |> pool(state)
county_pooled <- hospital_level |> filter(is_state_or_dc) |> pool(state, county_key)
```
```{r}
# ---- 4. Combine and  Write outputs -------------------------------------------------------
state_join <- state_pooled |>
  select(state, infection,
         state_n_hosp = n_hospitals, 
         state_obs = observed,
         state_pred = predicted, 
         state_sir = sir,
         state_ci_lower = ci_lower, 
         state_ci_upper = ci_upper,
         state_category = category)
county_join <- county_pooled |>
  select(state, county_key, infection,
         county_n_hosp = n_hospitals, 
         county_obs = observed,
         county_pred = predicted,
         county_sir = sir,
         county_ci_lower = ci_lower,
         county_ci_upper = ci_upper,
         county_category = category)
dashboard_data <- hospital_level |>
  left_join(state_join, by = c("state", "infection")) |>
  left_join(county_join, by = c("state", "county_key", "infection"))
stopifnot("join duplicated rows" = nrow(dashboard_data) == nrow(hospital_level))

write_csv(dashboard_data, "data/clean/dashboard_data.csv", na = "")
write_csv(hospital_level, "data/clean/hospital_level.csv", na = "")
write_csv(state_pooled, "data/clean/state_pooled.csv", na = "")
write_csv(county_pooled, "data/clean/county_pooled.csv", na = "")
